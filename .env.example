# Copy to .env and fill in. .env is git-ignored.

# LLM used by the host (client.py): openai (default) | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Scheduler config (exposed to the host via the scheduler://config resource)
TIMEZONE=Asia/Kolkata
WORK_START_HOUR=10
WORK_END_HOUR=18
SLOT_STEP_MINUTES=30
